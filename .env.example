# Copy to .env (git-ignored) and fill in. Names only here; never commit values.

# Cursor credential for model turns and the eval judge. Or run `npx agent-sdk login` instead.
CURSOR_API_KEY=

# Consumer Key of your Salesforce External Client App (README > Set up your org).
MCP_OAUTH_SALESFORCE_CLIENT_ID=

# Optional. `sandbox` (default) for sandboxes and scratch orgs, `production` for Developer Edition orgs.
SALESFORCE_ORG_TYPE=sandbox

# Optional. Which Salesforce Hosted MCP server to use. Default platform/headless-360.
# Set platform/sobject-all to use the sObject server instead; the evals adapt.
SALESFORCE_MCP_SERVER=platform/headless-360

# Optional. Full MCP URL override, for example a My Domain URL from Salesforce's "Find Your Server URL".
# SALESFORCE_MCP_URL=

# CI only: tokens for headless runs. Locally, `npm run auth` stores them for you.
# MCP_OAUTH_SALESFORCE_ACCESS_TOKEN=
# MCP_OAUTH_SALESFORCE_REFRESH_TOKEN=
